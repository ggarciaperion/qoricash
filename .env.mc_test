# ── Entorno local: integración Mission Control (qoricash_mc_test) ───────────
# Para iniciar: set -a; source .env.mc_test; set +a; flask run --port 5002
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL local con datos de demo del worker
DATABASE_URL=postgresql://localhost/qoricash_mc_test

# Seguridad (local)
SECRET_KEY=dev-mc-test-secret-2026

# Rate limiting desactivado en dev
RATELIMIT_ENABLED=False

# Session cookies (relajado para HTTP local)
SESSION_COOKIE_SECURE=False

# Email desactivado
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# APIs
APIS_NET_PE_TOKEN=sk_14277.x7jVJ5gbsLrwTmugqNkNTx2gfsGm64mA
CRON_SECRET=qoricash_cron_2026
QORICASH_WEB_URL=https://www.qoricash.pe
